# Copy this file to .env and fill in your own values. Never commit .env.
# Each user supplies their OWN Anthropic key, so you are never billed for anyone else's runs.
# ListingLens reads the key only from this exact name, never from a general ANTHROPIC_API_KEY
# that other applications may set. The MCP server does not use it today.
LISTINGLENS_ANTHROPIC_API_KEY=

# ListingLens builds the SEC User-Agent from its own product name and version;
# SEC's fair-access policy just requires a real contact email from you here.
SEC_EDGAR_CONTACT=your-email@example.com

# Optional: Langfuse tracing of each listinglens-memo run (D76). Leave both keys blank to send
# nothing. ListingLens reads only these names, never Langfuse's general LANGFUSE_* names that
# another project may set. Each region is its own account; the host must be one of Langfuse's
# cloud hosts.
LISTINGLENS_LANGFUSE_PUBLIC_KEY=
LISTINGLENS_LANGFUSE_SECRET_KEY=
LISTINGLENS_LANGFUSE_HOST=https://us.cloud.langfuse.com