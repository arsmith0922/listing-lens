# Copy this file to .env and fill in your own values. Never commit .env.
# Each user supplies their OWN Anthropic key, so you are never billed for anyone else's runs.
ANTHROPIC_API_KEY=your-key-here

# ListingLens builds the SEC User-Agent from its own product name and version;
# SEC's fair-access policy just requires a real contact email from you here.
SEC_EDGAR_CONTACT=your-email@example.com

# Optional: Langfuse tracing and cost (leave blank to disable).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com