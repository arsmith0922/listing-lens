# Copy this file to .env and fill in your own values. Never commit .env.
# Each user supplies their OWN Anthropic key, so you are never billed for anyone else's runs.
ANTHROPIC_API_KEY=your-key-here

# SEC EDGAR requires a descriptive User-Agent with contact info (their fair-access policy).
SEC_EDGAR_USER_AGENT=ListingLens/0.1 (your-email@example.com)

# Optional: Langfuse tracing and cost (leave blank to disable).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com